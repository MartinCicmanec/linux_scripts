#!/bin/bash
# Keep the host's default route off the KVM bridge when the bridge has no uplink.
#
# NetworkManager ignores carrier on bridges, so br0 keeps its DHCP lease (and its
# default route at metric 425, which beats wifi's 600) after the cable is pulled.
# The host then sends traffic into a dead bridge even though wifi is connected.
#
# On carrier loss we drop br0's IPv4 config, so the wifi route wins; the bridge
# device itself stays, so a running guest keeps its tap attached. On carrier
# return we restore it with `device reapply` -- `connection up` would detach any
# foreign (libvirt) port from the bridge.

set -u

BRIDGE=${BRIDGE:-br0}
PORT=${PORT:-enp0s31f6}

log() { logger -t br0-uplink-watch -- "$*"; }

guest_attached() {
	bridge link show master "$BRIDGE" 2>/dev/null |
		grep -qE '^[0-9]+: (vnet|tap|macvtap)'
}

apply() {
	local carrier
	carrier=$(cat "/sys/class/net/$PORT/carrier" 2>/dev/null) || carrier=0

	if [ "$carrier" = 1 ]; then
		if [ -n "$(ip -4 -br addr show "$BRIDGE" | awk '{print $3}')" ]; then
			return 0 # uplink is up and the bridge already has an address
		fi
		if guest_attached; then
			log "uplink back on $PORT, reapplying $BRIDGE (guest attached)"
			nmcli device reapply "$BRIDGE" >/dev/null
		else
			log "uplink back on $PORT, reactivating $BRIDGE"
			nmcli connection up "$BRIDGE" >/dev/null
		fi
	else
		if [ -z "$(ip -4 -br addr show "$BRIDGE" | awk '{print $3}')" ]; then
			return 0 # already cleared
		fi
		log "no uplink on $PORT, clearing $BRIDGE IPv4 so wifi takes over"
		ip -4 addr flush dev "$BRIDGE"
		resolvectl revert "$BRIDGE" 2>/dev/null
	fi
}

apply

# React to carrier changes; coalesce bursts of netlink messages.
ip monitor link dev "$PORT" | while read -r _; do
	read -r -t 2 _ || true # debounce link flaps
	apply
done
